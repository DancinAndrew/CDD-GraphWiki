{
  "description": "圖譜中節點與節點之間的有向關係邊。",
  "properties": {
    "edge_id": {
      "description": "Unique edge identifier, e.g. 'nodeA_to_nodeB_requires'",
      "title": "Edge Id",
      "type": "string"
    },
    "source_id": {
      "description": "Source node ID",
      "title": "Source Id",
      "type": "string"
    },
    "target_id": {
      "description": "Target node ID",
      "title": "Target Id",
      "type": "string"
    },
    "edge_type": {
      "description": "Relationship semantic type",
      "enum": [
        "defines",
        "requires",
        "applies_to",
        "conditioned_on",
        "except_when",
        "requires_evidence",
        "references_clause",
        "same_as",
        "stricter_than",
        "supersedes",
        "conflicts_with",
        "derived_from",
        "decision_path"
      ],
      "title": "Edge Type",
      "type": "string"
    },
    "label": {
      "description": "Human-readable edge label",
      "title": "Label",
      "type": "string"
    },
    "properties": {
      "type": "object",
      "additionalProperties": true,
      "description": "Edge metadata payload, e.g., weight, reasoning_logic",
      "title": "Properties"
    }
  },
  "required": [
    "edge_id",
    "source_id",
    "target_id",
    "edge_type",
    "label"
  ],
  "title": "GraphEdge",
  "type": "object"
}