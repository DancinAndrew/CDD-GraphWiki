{
  "$defs": {
    "EvidenceSpan": {
      "description": "規則判斷所依據的一段條文原文：位置是該條文 raw_text 的字元索引，text 恰為 raw_text[start:end]。",
      "properties": {
        "clause_id": {
          "description": "Clause whose raw_text holds the span",
          "title": "Clause Id",
          "type": "string"
        },
        "start": {
          "description": "Character offset into that clause's raw_text",
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "description": "End offset (exclusive)",
          "title": "End",
          "type": "integer"
        },
        "text": {
          "description": "Exactly raw_text[start:end]",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "clause_id",
        "start",
        "end",
        "text"
      ],
      "title": "EvidenceSpan",
      "type": "object"
    },
    "RuleReason": {
      "description": "規則式抽取器為某條文標上某義務類型的一個理由：哪條規則、一句說明，以及讓規則成立的所有原文證據。",
      "properties": {
        "rule": {
          "description": "Stable rule id, e.g. 'identify.subject'",
          "title": "Rule",
          "type": "string"
        },
        "obligation_type": {
          "description": "One of the rule types in src/extraction/frames.py",
          "title": "Obligation Type",
          "type": "string"
        },
        "message": {
          "description": "One plain English sentence saying why",
          "title": "Message",
          "type": "string"
        },
        "spans": {
          "description": "All text that made the rule fire",
          "items": {
            "$ref": "#/$defs/EvidenceSpan"
          },
          "title": "Spans",
          "type": "array"
        },
        "depends_on": {
          "description": "Other labels this reason relies on, as '<clause_id>#<type>'",
          "items": {
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        }
      },
      "required": [
        "rule",
        "obligation_type",
        "message"
      ],
      "title": "RuleReason",
      "type": "object"
    }
  },
  "description": "從條款中抽取的機器可讀合規義務規則。",
  "properties": {
    "obligation_id": {
      "description": "e.g., identify_beneficial_owner",
      "title": "Obligation Id",
      "type": "string"
    },
    "source_clause_ids": {
      "description": "List of clause IDs, ensuring clause-level provenance",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Clause Ids",
      "type": "array"
    },
    "jurisdiction": {
      "description": "Jurisdiction of the obligation",
      "title": "Jurisdiction",
      "type": "string"
    },
    "actor": {
      "description": "e.g., financial_institution",
      "title": "Actor",
      "type": "string"
    },
    "action": {
      "description": "e.g., identify_and_verify",
      "title": "Action",
      "type": "string"
    },
    "object": {
      "description": "e.g., beneficial_owner",
      "title": "Object",
      "type": "string"
    },
    "applies_to": {
      "additionalProperties": true,
      "description": "Entity constraints",
      "title": "Applies To",
      "type": "object"
    },
    "conditions": {
      "description": "Factual triggers",
      "items": {
        "type": "string"
      },
      "title": "Conditions",
      "type": "array"
    },
    "exceptions": {
      "description": "Exemptions",
      "items": {
        "type": "string"
      },
      "title": "Exceptions",
      "type": "array"
    },
    "required_evidence": {
      "description": "Required evidence",
      "items": {
        "type": "string"
      },
      "title": "Required Evidence",
      "type": "array"
    },
    "review_flags": {
      "description": "Triggers for human review",
      "items": {
        "type": "string"
      },
      "title": "Review Flags",
      "type": "array"
    },
    "confidence": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Rule-extracted: measured precision of this rule type on unseen held-out text (None when not measured). LLM-imported: the model's self-reported, uncalibrated score.",
      "title": "Confidence"
    },
    "confidence_basis": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "One sentence saying where the confidence comes from, including the sample it was measured on",
      "title": "Confidence Basis"
    },
    "confidence_kind": {
      "anyOf": [
        {
          "enum": [
            "measured_on_heldout",
            "self_reported"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "What the confidence is: 'measured_on_heldout' = precision measured on unseen held-out text; 'self_reported' = the LLM's own uncalibrated score; None = no confidence",
      "title": "Confidence Kind"
    },
    "review_status": {
      "default": "pending_human_review",
      "description": "Verification state",
      "enum": [
        "pending_human_review",
        "approved"
      ],
      "title": "Review Status",
      "type": "string"
    },
    "explanations": {
      "additionalProperties": {
        "items": {
          "$ref": "#/$defs/RuleReason"
        },
        "type": "array"
      },
      "description": "Rule reasons per source clause ID (rule-extracted obligations only)",
      "title": "Explanations",
      "type": "object"
    }
  },
  "required": [
    "obligation_id",
    "source_clause_ids",
    "jurisdiction",
    "actor",
    "action",
    "object"
  ],
  "title": "Obligation",
  "type": "object"
}