{
  "description": "結構化客戶情境，用於進行 CDD 風險畫像比對。",
  "properties": {
    "customer_id": {
      "title": "Customer Id",
      "type": "string"
    },
    "customer_type": {
      "description": "Customer classification",
      "enum": [
        "individual",
        "corporate"
      ],
      "title": "Customer Type",
      "type": "string"
    },
    "registration_jurisdiction": {
      "title": "Registration Jurisdiction",
      "type": "string"
    },
    "ownership_layers": {
      "title": "Ownership Layers",
      "type": "integer"
    },
    "ubo_status": {
      "description": "Ultimate Beneficial Owner status",
      "enum": [
        "identified",
        "unclear"
      ],
      "title": "Ubo Status",
      "type": "string"
    },
    "ubo_country_risk": {
      "description": "Country-associated risk level",
      "enum": [
        "low",
        "medium",
        "high"
      ],
