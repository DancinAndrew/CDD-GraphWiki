      "type": "string"
    },
    "pep_exposure": {
      "title": "Pep Exposure",
      "type": "boolean"
    },
    "source_of_funds_available": {
      "title": "Source Of Funds Available",
      "type": "boolean"
    },
    "source_of_wealth_available": {
      "title": "Source Of Wealth Available",
      "type": "boolean"
    },
    "custom_attributes": {
      "additionalProperties": true,
      "description": "Dynamic data payload for 'schema-light' flexibility",
      "title": "Custom Attributes",
      "type": "object"
    }
  },
  "required": [
    "customer_id",
    "customer_type",
    "registration_jurisdiction",
    "ownership_layers",
    "ubo_status",
    "ubo_country_risk",
    "pep_exposure",
    "source_of_funds_available",
    "source_of_wealth_available"
