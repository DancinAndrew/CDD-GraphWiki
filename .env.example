# ==============================================================================
# CDD-GraphWiki 環境變數配置範本 (.env.example)
# ==============================================================================
# 請複製此檔案並重新命名為 `.env`，然後填入您真實的 API 憑證。
# 注意：`.env` 檔案已被列入 `.gitignore`，請絕對不要將包含真實金鑰的 `.env` 提交至 Git 歷史或 push 至 GitHub！
# ==============================================================================

# ------------------------------------------------------------------------------
# NVIDIA NIM API 配置
# ------------------------------------------------------------------------------

# NVIDIA NIM API 密鑰 (例如：nvapi-xxx...)
NVIDIA_API_KEY=your_nvidia_api_key_here

# 子任務一：智慧切片模型配置 (LLMHierarchicalChunker)
# 預設建議使用 Llama 3.3 70B 指令微調版模型
NIM_CHUNKER_MODEL=meta/llama-3.3-70b-instruct

# 子任務二：義務抽取模型配置 (LLMStructuredExtractor)
# 預設建議使用 DeepSeek 系列模型 (例如 deepseek-v4-pro 或 deepseek-r1)
NIM_EXTRACTOR_MODEL=deepseek-ai/deepseek-v4-pro

# API 基本 URL (NVIDIA NIM 平台標準端點)
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# ------------------------------------------------------------------------------
# Gemini API 配置 (雙引擎相容與備用)
# ------------------------------------------------------------------------------

# Gemini API 密鑰 (若使用 Gemini 降級引擎)
GEMINI_API_KEY=your_gemini_api_key_here
